# Copy this file to .env and adjust as needed.

# SQLite is the default so the project runs with zero external setup.
# For Postgres, use something like:
# DATABASE_URL=postgresql+psycopg://scamshield:password@localhost:5432/scamshield
DATABASE_URL=sqlite:///./scamshield.db

# Shared secret required in the X-Moderator-Key header for moderation
# endpoints. Change this before deploying anywhere beyond your own machine.
MODERATOR_API_KEY=000000

# Risk-scoring thresholds (see app/scoring.py)
REPORT_THRESHOLD=3
SCORE_THRESHOLD=55

# Comma-separated origins allowed to call this API from a browser
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
