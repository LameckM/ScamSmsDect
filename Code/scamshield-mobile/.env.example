# Copy this file to .env and adjust before running.
#
# IMPORTANT: if you're testing on a physical phone via Expo Go, "localhost"
# refers to the phone itself, not your computer. Use your computer's LAN IP
# address instead (see README "Connecting to the backend").
#
# - iOS Simulator:  http://localhost:8000        (works as-is)
# - Android Emulator: http://10.0.2.2:8000        (special alias to host machine)
# - Physical phone (Expo Go): http://<your-computer's-LAN-IP>:8000

EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
